# Copy to .env (mode 600) on the server. Never commit .env.
POSTGRES_PASSWORD=
# Admin key for croak-gate; issue per-user virtual keys with it.
LITELLM_MASTER_KEY=sk-
# The LiteLLM that croak-gate forwards to.
UPSTREAM_API_BASE=http://upstream.example.internal:44000/v1
UPSTREAM_API_KEY=
# Upstream key for qwen3.8-27b-nvfp4 and worker-chat.
UPSTREAM_API_KEY_QWEN=
CROAK_GATE_PORT=4100
# Server account that owns data/audit and data/archive (id -u / id -g).
CROAK_DATA_UID=1000
CROAK_DATA_GID=1000

# HTTPS port of the TLS front (Caddy). Certificates come from tls/make-certs.sh.
# CROAK_TLS_PORT=8443

# Public HTTPS address of this gate (login links, admin console). Required.
CROAK_PUBLIC_URL=https://gate.example.internal:8443
# Minimum client version (docs/client-versions.md). 1 rejects clients older
# than the minimum; leave 0 until every PC runs the release that sends its version.
CROAK_CLIENT_VERSION_ENFORCE=0
# Optional: overrides the release manifest's minimum (a release version X.Y.Z).
CROAK_CLIENT_MINIMUM=
