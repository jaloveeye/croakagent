# TLS front for croak-gate. Only the OpenAI-compatible API and the liveness
# check reach LiteLLM; its admin routes (/key/*, /user/*, UI) stay internal.
{
	auto_https off
	admin off
}

:8443 {
	tls /certs/server.crt /certs/server.key

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	# People type the page address without the trailing slash; send them to it.
	redir /download /download/ 308
	handle_path /download/* {
		root * /downloads
		file_server
	}

	# Execution permits for croakcode tool calls are signed by croak-auth.
	# Listed before @gate, which would otherwise take every /v1/* path.
	# Execution permits and the model list are the login service's.
	@permit path /v1/execution-permits /v1/croak/*
	handle @permit {
		forward_auth auth:8000 {
			uri /internal/client-version
		}
		reverse_proxy auth:8000
	}

	@gate path /v1/*
	handle @gate {
		forward_auth auth:8000 {
			uri /internal/client-version
		}
		reverse_proxy gate:4000 {
			# Stream tokens as they arrive.
			flush_interval -1
		}
	}
	handle /health/liveliness {
		reverse_proxy gate:4000
	}

	@auth path / /auth/* /admin /admin/*
	handle @auth {
		reverse_proxy auth:8000
	}

	handle {
		respond "not found" 404
	}
}
